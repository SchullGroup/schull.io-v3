# Copy this to .env.local to override any of these on your own machine.
# .env.local is gitignored — never commit real values.

# Where the "Send us a message" contact form sends its POST request.
# Leave unset to use the staging backend (the current default, see
# content/site.js). Set this once the team moves to the production backend:
# NEXT_PUBLIC_CONTACT_API_BASE=https://api-lms.schull.io
